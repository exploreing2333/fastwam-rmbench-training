+    def _get_episode_uniform_image_indices(self, idx: int, ep_idx: int) -> list[int]:
+        """Return rounded linspace indices from the episode start through ``idx``."""
+        num_frames = self.episode_uniform_image_history_frames
+        if num_frames <= 0:
+            return []
+        ep_start = int(self.episode_data_index["from"][ep_idx].item())
+        ep_end = int(self.episode_data_index["to"][ep_idx].item())
+        if idx < ep_start or idx >= ep_end:
+            raise IndexError(
+                f"Sample index {idx} is outside episode range [{ep_start}, {ep_end})."
+            )
+        if num_frames == 1:
+            return [idx]
+
+        span = idx - ep_start
+        denominator = num_frames - 1
+        # Integer round-to-nearest avoids floating-point drift while preserving both endpoints.
+        return [
+            ep_start + (frame_idx * span + denominator // 2) // denominator
+            for frame_idx in range(num_frames)
+        ]
+
+    def _get_episode_causal_history_indices(self, idx: int, ep_idx: int) -> list[int]:
+        """Match Robometer's real-frame causal prefix sampling exactly."""
+        max_frames = self.episode_causal_history_frames
+        if max_frames <= 0:
+            return []
+        ep_start = int(self.episode_data_index["from"][ep_idx].item())
+        ep_end = int(self.episode_data_index["to"][ep_idx].item())
+        if idx < ep_start or idx >= ep_end:
+            raise IndexError(
+                f"Sample index {idx} is outside episode range [{ep_start}, {ep_end})."
+            )
+        if getattr(
+            self,
+            "episode_causal_history_sampling",
+            "causal_uniform",
+        ) == "preprogress":
+            if max_frames != 8:
+                raise ValueError("preprogress requires eight causal history frames")
+            local_query = idx - ep_start
+            history_start = max(0, local_query - 16)
+            global_indices = np.rint(
+                np.linspace(0, history_start, 4)
+            ).astype(np.int64)
+            global_indices[0] = 0
+            global_indices[-1] = history_start
+            recent_tail = [
+                max(0, local_query - offset)
+                for offset in (12, 8, 4, 0)
+            ]
+            return (
+                np.asarray([*global_indices.tolist(), *recent_tail])
+                + ep_start
+            ).tolist()
+        prefix_length = idx - ep_start + 1
+        if prefix_length <= max_frames:
+            return list(range(ep_start, idx + 1))
+        local_indices = np.rint(
+            np.linspace(0, idx - ep_start, max_frames)
+        ).astype(np.int64)
+        local_indices[0] = 0
+        local_indices[-1] = idx - ep_start
+        return (local_indices + ep_start).tolist()
